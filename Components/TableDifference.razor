<MudPaper Class="pa-4 mt-4">

    <MudText Typo="Typo.h6" Class="mb-3">
        @Title
    </MudText>

    @if (Difference == null || !Difference.Any())
    {
        <MudAlert Severity="Severity.Success">
            Sem diferenças encontradas 🎉
        </MudAlert>
    }
    else
    {
        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">

            <MudText Typo="Typo.h6">
                @Title
            </MudText>
        </MudStack>

        <MudTextField @bind-Value="searchString"
                      Placeholder="Buscar em tudo..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Clearable="true"
                      Style="max-width:300px;" />

        <MudDataGrid T="Difference"
                     Items="Difference"
                     Filterable="true"
                     SortMode="SortMode.Multiple"
                     Groupable="true"
                     Dense="true"
                     Hover="true"
                     Bordered="true"
                     Striped="true"
                     Virtualize="true"
                     QuickFilter="@FiltroGlobal"
                     FilterMode="DataGridFilterMode.ColumnFilterMenu"
                     FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive">

            <Columns>

                <!-- 🔹 ID -->
                <PropertyColumn Property="x => x.Id"
                                Title="ID"
                                Filterable="true">
                    <CellTemplate>
                        @context.Item.Id
                    </CellTemplate>
                </PropertyColumn>

                <!-- 🔹 Campo -->
                <PropertyColumn Property="x => x.Campo"
                                Title="Campo"
                                Filterable="true">
                    <CellTemplate>
                        <MudChip T="string"
                                 Color="Color.Primary"
                                 Variant="Variant.Outlined">

                            @context.Item.Campo

                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>

                <!-- 🔹 Valor A -->
                <PropertyColumn Property="x => x.ValorA"
                                Title="Valor A"
                                Filterable="true">
                    <CellTemplate>
                        <MudTooltip Text="@context.Item.ValorA">
                            <span class="text-truncate">
                                @context.Item.ValorA
                            </span>
                        </MudTooltip>
                    </CellTemplate>
                </PropertyColumn>

                <!-- 🔹 Valor B -->
                <PropertyColumn Property="x => x.ValorB"
                                Title="Valor B"
                                Filterable="true">
                    <CellTemplate>
                        <MudTooltip Text="@context.Item.ValorB">
                            <span class="text-truncate text-danger fw-bold">
                                @context.Item.ValorB
                            </span>
                        </MudTooltip>
                    </CellTemplate>
                </PropertyColumn>

            </Columns>

            <PagerContent>
                <MudDataGridPager T="Difference" />
            </PagerContent>

        </MudDataGrid>
    }

</MudPaper>

@code {
    [Parameter]
    public List<Difference> Difference { get; set; } = new();

    [Parameter]
    public string Title { get; set; } = "Diferenças";

    private string searchString = "";

    private Func<Difference, bool> FiltroGlobal => item =>
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        return
            (item.Id?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            ||
            (item.Campo?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            ||
            (item.ValorA?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            ||
            (item.ValorB?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false);
    };
}