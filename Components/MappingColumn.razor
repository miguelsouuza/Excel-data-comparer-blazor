@inject NavigationManager nav
@inject IHeaderCompareService _headerCompareService
@inject IAutoMappingService _autoMappingService
@inject AppState _appState

<MudPaper Class="pa-4 mt-4 mapping-container">
    <MudPaper Class="d-flex justify-space-between flex-grow-1 gap-4" Elevation="0">
        <MudText Typo="Typo.h6">Mapeamento de Colunas</MudText>
        <MudIconButton Class="mapping-close " Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Medium" OnClick="ToggleMappingColumn" />
    </MudPaper>

    <!-- 🔹 IDs -->
    <MudGrid Class="mb-4">
            <!-- 🔹 IDs Base A -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">

                    <MudText Typo="Typo.h6">
                        IDs Base A 🔑
                    </MudText>

                    @foreach (var col in ColunasA)
                    {
                        <MudCheckBox T="bool"
                                     Label="@col"
                                     Value="@idsALocal.Contains(col)"
                                     ValueChanged="@( (bool value) => ToggleIdA(col, value) )" />
                    }
                </MudPaper>
            </MudItem>

            <!-- 🔹 IDs Base B -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6">
                        IDs Base B 🔑
                    </MudText>

                    @foreach (var col in ColunasB)
                    {
                        <MudCheckBox T="bool"
                                     Label="@col"
                                     Value="@idsBLocal.Contains(col)"
                                     ValueChanged="@( (bool value) => ToggleIdB(col, value) )" />
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

      @*   <!-- 🔹 Base A -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3">
                <MudText Typo="Typo.h6">
                    IDs Base A 🔑
                </MudText>

                @foreach (var col in ColunasA)
                {
                    <MudCheckBox T="bool"
                                 Label="@col"
                                 Value="@IdsA.Contains(col)"
                                 ValueChanged="@( (bool value) => ToggleIdA(col, value) )" />
                }
            </MudPaper>
        </MudItem>

        <!-- 🔹 Base B -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3">
                <MudText Typo="Typo.h6">
                    IDs Base B 🔑
                </MudText>

                @foreach (var col in ColunasB)
                {
                    <MudCheckBox T="bool"
                                 Label="@col"
                                 Value="@IdsB.Contains(col)"
                                 ValueChanged="@( (bool value) => ToggleIdB(col, value) )" />
                }

            </MudPaper>
        </MudItem>
    </MudGrid> *@

    <MudButton Class="mapping-top-right" Color="Color.Primary" OnClick="AutoMapear" Variant="Variant.Filled">AUTO MAPEAR 🤖</MudButton>

    @foreach (var mapColA in ColunasA)
    {
        <MudGrid Class="mb-2">
            <MudItem xs="5">
                <MudText>@mapColA</MudText>
            </MudItem>

            <MudItem xs="7">
                <MudSelect T="string"
                           @key="mapColA"
                           @bind-Value="MapeamentoUI[mapColA]">

                    <MudSelectItem T="string">Selecione</MudSelectItem>

                    @foreach (var enabledColB in GetColunasDisponiveis(mapColA))
                    {
                        <MudSelectItem @key="enabledColB" Value="@enabledColB">@enabledColB</MudSelectItem>
                    }

                </MudSelect>
            </MudItem>
        </MudGrid>
    }

    <MudButton Class="mapping-bottom-right" Color="Color.Success" OnClick="IrParaComparacao" Variant="Variant.Filled">COMPARAR DADOS</MudButton>
</MudPaper>

@code {
    [Parameter]
    public bool showMappingColumn { get; set; } = false;
    [Parameter]
    public HeaderCompareResult? headerResult { get; set; } = new HeaderCompareResult();
    [Parameter]
    public List<GenericRegistration> baseA { get; set; } = new List<GenericRegistration>();
    [Parameter]
    public List<GenericRegistration> baseB { get; set; } = new List<GenericRegistration>();
    [Parameter]
    public List<string> IdsA { get; set; } = new();
    [Parameter]
    public List<string> IdsB { get; set; } = new();
    private List<string> idsALocal = new();
    private List<string> idsBLocal = new();
    [Parameter]
    public Dictionary<string, string> Mapeamento { get; set; } = new();
    [Parameter]
    public Dictionary<string, string> MapeamentoUI { get; set; } = new();
    [Parameter]
    public List<string> ColunasA { get; set; } = new();
    [Parameter]
    public List<string> ColunasB { get; set; } = new();

    protected override void OnParametersSet()
    {
        idsALocal = IdsA.ToList();
        idsBLocal = IdsB.ToList();
    }
    private void ToggleMappingColumn()
    {
        showMappingColumn = !showMappingColumn;
    }

    private void AutoMapear()
    {
        var auto = _autoMappingService.GerarMapeamento(
            baseA.First().Campos.Keys.ToList(),
            baseB.First().Campos.Keys.ToList()
        );

        foreach (var item in auto)
        {
            Mapeamento[item.Key] = item.Value;
            MapeamentoUI[item.Key] = item.Value;
        }
    }

    private List<string> GetColunasDisponiveis(string colunaAtual)
    {
        var todas = baseB.First().Campos.Keys.ToList();

        var usadas = Mapeamento
            .Where(x => x.Key != colunaAtual)
            .Select(x => x.Value)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .ToHashSet();

        return todas
            .Where(col => !usadas.Contains(col) || Mapeamento[colunaAtual] == col)
            .ToList();
    }

    private void IrParaComparacao()
    {
        _appState.IdsA = idsALocal;
        _appState.IdsB = idsBLocal;
        _appState.Mapeamento = Mapeamento;

        nav.NavigateTo("/compare");
    }

    private void ToggleIdA(string coluna, bool selecionado)
    {
        if (selecionado)
        {
            if (!idsALocal.Contains(coluna))
                idsALocal.Add(coluna);
        }
        else
        {
            idsALocal.Remove(coluna);
        }
    }
    private void ToggleIdB(string coluna, bool selecionado)
    {
        if (selecionado)
        {
            if (!idsBLocal.Contains(coluna))
                idsBLocal.Add(coluna);
        }
        else
        {
            idsBLocal.Remove(coluna);
        }
    }
}
