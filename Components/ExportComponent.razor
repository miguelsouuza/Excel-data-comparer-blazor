@using Microsoft.AspNetCore.Components
@inject NavigationManager nav
@inject AppState _appState

<div class="mt-2">
    <MudStack Row="true" Spacing="1" Class="mt-2">
        <a href="@GetUrl("csv")" target="_blank">
        @* <MudButton Color="Color.Info" Disabled="!Enabled" OnClick="ExportCsv">Baixar CSV</MudButton> *@
        <MudButton Color="Color.Info" Disabled="!Enabled">Baixar CSV</MudButton>
        </a>
        <a href="@GetUrl("xlsx")" target="_blank">
            @* <MudButton Color="Color.Info" Disabled="!Enabled" OnClick="ExportXlsx">Baixar XLSX</MudButton> *@
            <MudButton Color="Color.Info" Disabled="!Enabled">Baixar XLSX</MudButton>
        </a>
        <a href="@GetUrl("json")" target="_blank">
        @* <MudButton Color="Color.Info" Disabled="!Enabled" OnClick="ExportJson">Baixar JSON</MudButton> *@
        <MudButton Color="Color.Info" Disabled="!Enabled">Baixar JSON</MudButton>
        </a>
    </MudStack>
</div>

@code {
    [Parameter]
    public bool Enabled { get; set; } = false;

    private string GetUrl(string tipo)
    {
        var nome = Uri.EscapeDataString(_appState.NomeArquivoExportacao ?? "baseb");
        return $"/download/baseb/{tipo}?name={nome}&t={DateTime.Now.Ticks}";
    }
