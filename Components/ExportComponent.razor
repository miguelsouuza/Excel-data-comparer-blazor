@using Microsoft.AspNetCore.Components
@inject NavigationManager nav
@inject AppState _appState

<div class="mt-2">   
    <MudStack Row="true" Spacing="1" Class="mt-2">
        <MudButton Color="Color.Info" Disabled="!Enabled" OnClick="ExportCsv">Baixar CSV</MudButton>
        <MudButton Color="Color.Info" Disabled="!Enabled" OnClick="ExportXlsx">Baixar XLSX</MudButton>
        <MudButton Color="Color.Info" Disabled="!Enabled" OnClick="ExportJson">Baixar JSON</MudButton>
    </MudStack>
</div>

@code {
    [Parameter]
    public bool Enabled { get; set; } = false;

    private void ExportCsv()
    {
        
        var nome = Uri.EscapeDataString(_appState.NomeArquivoExportacao ?? "");

        nav.NavigateTo($"/download/baseb/csv?name={nome}&t={DateTime.Now.Ticks}", true);
    }

    private void ExportJson()
    {
        var nome = Uri.EscapeDataString(_appState.NomeArquivoExportacao ?? "");

        nav.NavigateTo($"/download/baseb/json?name={nome}&t={DateTime.Now.Ticks}", true);
    }

    private void ExportXlsx()
    {
        var nome = Uri.EscapeDataString(_appState.NomeArquivoExportacao ?? "");

        nav.NavigateTo($"/download/baseb/xlsx?name={nome}&t={DateTime.Now.Ticks}", true);
    }

}
