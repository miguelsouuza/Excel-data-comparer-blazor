<MudPaper Class="pa-3 mt-3">

    <MudText Typo="Typo.h6">@Title</MudText>

    <MudTable Items="Base.Take(5)" Dense="true" Hover="true" Bordered="true">

        <HeaderContent>
            @foreach (var col in Base.First().Campos.Keys)
            {
                <MudTh>@col</MudTh>
            }
        </HeaderContent>

        <RowTemplate>
            @foreach (var col in context.Campos.Keys)
            {
                <MudTd Class="@(col == "NOME" ? "fw-bold" : "")">@context.Campos[col]</MudTd>
            }
        </RowTemplate>

    </MudTable>

</MudPaper>

@code {
    [Parameter]
    public List<GenericRegistration> Base { get; set; } = new();
    [Parameter]
    public string? Title { get; set; }

}
