    private async Task BaixarXlsx()
    {
        var bytes = _fileService.GerarExcelBytes(
            _appState.MapeamentosPorAba,
            _appState.NomeArquivoExportacao);

        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"{_appState.NomeArquivoExportacao}.xlsx",
            base64,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
