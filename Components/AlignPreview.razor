@using DataComparer.Models
@using Microsoft.AspNetCore.Components
@using System.Linq
@inject AppState _appState
@inject IAutoMappingService _autoMappingService

<MudPaper Class="pa-4">
    <MudPaper Class="d-flex justify-space-between flex-grow-1 gap-4 mb-4" Elevation="0">
        <MudText Typo="Typo.h6">Resultados do Alinhamento</MudText>
        <MudIconButton Class="mapping-close " Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Close" OnClick="Close"></MudIconButton>
    </MudPaper>

    @if (Result == null)
    {
        <div>Nenhum resultado disponível</div>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.subtitle2">Renomeadas</MudText>
                    @if (Result.Renomeadas.Any())
                    {
                        <MudList Dense="true" T="string">
                            @foreach (var r in Result.Renomeadas)
                            {
                                <MudListItem>
                                    @r.ColunaA -> @r.ColunaB
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <div>—</div>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.subtitle2">Mantidas</MudText>
                    @if (Result.Mantidas.Any())
                    {
                        <MudList Dense="true" T="string">
                            @foreach (var m in Result.Mantidas)
                            {
                                <MudListItem>
                                    @m
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <div>—</div>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.subtitle2">Removidas</MudText>
                    @if (Result.Removidas.Any())
                    {
                        <MudList Dense="true" T="string">
                            @foreach (var rm in Result.Removidas)
                            {
                                <MudListItem>
                                    @rm
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <div>—</div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <div class="mt-3">
            <MudText Typo="Typo.subtitle2">Preview (primeiras 10 linhas)</MudText>

            @if (Result.Alinhada.Any())
            {
                var headers = Result.Alinhada.First().Campos.Keys.ToList();

                <MudTable Items="Result.Alinhada.Take(10)" Dense="true" Bordered="true" Hover="true">
                    <HeaderContent>
                        @foreach (var h in headers)
                        {
                            <MudTh>@h</MudTh>
                        }
                    </HeaderContent>

                    <RowTemplate Context="row">
                        @foreach (var h in headers)
                        {
                            <MudTd>@row.Campos[h]</MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <div>Nenhuma linha para mostrar</div>
            }
        </div>
        <MudPaper Class="pa-3 mt-4">

            <MudText Typo="Typo.subtitle2" Class="mb-2">
                Delimitador CSV
            </MudText>

            <MudSelect T="string"
                       Disabled="textDisabled"
                       Label="Selecione o delimitador"
                       @bind-Value="delimitadorCsv">

                <MudSelectItem T="string" Value="@pontoVirgula">
                    Ponto e vírgula (;)
                </MudSelectItem>

                <MudSelectItem T="string" Value="@virgula">
                    Vírgula (,)
                </MudSelectItem>

                <MudSelectItem T="string" Value="@pipe">
                    Pipe (|)
                </MudSelectItem>

                <MudSelectItem T="string" Value="@TAB">
                    Tabulação (\t)
                </MudSelectItem>
            </MudSelect>
        </MudPaper>

        <div class="mt-3">
            <MudPaper Class="pa-3 mt-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">
                    Nome do arquivo exportado
                </MudText>
                <MudTextField T="string"
                              Disabled="textDisabled"
                              Label="Nome do arquivo"
                              Immediate="true"
                              ValueChanged="OnNomeChanged"
                              Value="nomeArquivoExportacao"
                              Variant="Variant.Outlined" />
            </MudPaper>

            @if (colunasNovas.Any())
            {
                <MudPaper Class="pa-3 mt-4">

                    <MudText Typo="Typo.h6">
                        Preenchimento de novas colunas
                    </MudText>

                    @foreach (var coluna in colunasNovas)
                    {
                        <MudDivider Class="my-2" />

                        <MudText Typo="Typo.subtitle2">
                            @coluna
                        </MudText>

                        <MudSelect T="string"
                                   Label="Usar valor da coluna da Base A"
                                   @bind-Value="colunasFixasDaBaseA[coluna]">

                            <MudSelectItem T="string">
                                Nenhum
                            </MudSelectItem>

                            @foreach (var colA in headersAAtual)
                            {
                                <MudSelectItem T="string" Value="@colA">
                                    @colA
                                </MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string"
                                   Label="Usar valor da coluna da Base B"
                                   @bind-Value="colunasDaBaseB[coluna]">

                            <MudSelectItem T="string">
                                Nenhum
                            </MudSelectItem>

                            @foreach (var colB in headersBAtual)
                            {
                                <MudSelectItem T="string" Value="@colB">
                                    @colB
                                </MudSelectItem>
                            }
                        </MudSelect>


                        <MudTextField T="string"
                                      Label="Ou usar valor fixo"
                                      @bind-Value="valoresFixos[coluna]"
                                      Immediate="true" />

                        <MudTextField T="string"
                                      Label="Template personalizado"
                                      @bind-Value="templatesPersonalizados[coluna]" />
                    }
                </MudPaper>
            }
            <ExportComponent Disabled="buttonExportDisabled" />
        </div>

        <div class="d-flex justify-content-end mt-3">

            <MudButton Color="Color.Success" OnClick="Confirm">Confirmar e usar este resultado</MudButton>
            <div>
                @if (buttonCancelEnabled)
                {
                    <MudButton Color="Color.Error"
                               Variant="Variant.Outlined"
                               OnClick="CancelarConfirmacao">
                        Cancelar confirmação
                    </MudButton>
                }
            </div>
        </div>
    }
</MudPaper>

@code {
    [Parameter]
    public AlignmentResult Result { get; set; }

    [Parameter]
    public EventCallback OnConfirmed { get; set; }

    [Parameter]
    public string abaSelecionadaA { get; set; }

    [Parameter]
    public string abaSelecionadaB { get; set; }

    [Parameter]
    public List<string> headersAAtual { get; set; }

    [Parameter]
    public List<string> headersBAtual { get; set; }

    [Parameter]
    public Dictionary<string, string> mappingAtual { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private Dictionary<string, string> colunasDaBaseB = new();
    private Dictionary<string, string> colunasFixasDaBaseA = new();
    private Dictionary<string, string> valoresFixos = new();
    private List<string> colunasNovas = new();
    private Dictionary<string, string> templatesPersonalizados = new();

    private bool buttonExportDisabled = true;
    private bool textDisabled = false;
    private bool nomeInicializado = false;
    private bool buttonCancelEnabled = false;

    private string nomeArquivoExportacao = "";
    private string delimitadorCsv = ";";
    private const string TAB = "\t";
    private const string virgula = ",";
    private const string pipe = "|";
    private const string pontoVirgula = ";";



    protected override void OnParametersSet()
    {
        if (!nomeInicializado)
        {
            nomeArquivoExportacao =
                Path.GetFileNameWithoutExtension(_appState.NomeArquivoA);

            nomeInicializado = true;
        }

        colunasNovas = headersAAtual
            .Where(h =>
                !headersBAtual.Any(x =>
                    x.Equals(h, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        foreach (var coluna in colunasNovas)
        {
            if (!colunasFixasDaBaseA.ContainsKey(coluna))
            {
                colunasFixasDaBaseA[coluna] = "";
            }

            if (!valoresFixos.ContainsKey(coluna))
            {
                valoresFixos[coluna] = "";
            }
            if (!templatesPersonalizados.ContainsKey(coluna))
            {
                templatesPersonalizados[coluna] = "";
            }
            if (!colunasDaBaseB.ContainsKey(coluna))
            {
                colunasDaBaseB[coluna] = "";
            }
        }
    }

    private void CancelarConfirmacao()
    {
        buttonCancelEnabled = false;
        textDisabled = false;

        var keyB = Helpers.Normalize(abaSelecionadaB);

        if (_appState.MapeamentosPorAba.ContainsKey(keyB))
        {
            _appState.MapeamentosPorAba.Remove(keyB);
        }

        StateHasChanged();
    }

    private void OnNomeChanged(string value)
    {
        nomeArquivoExportacao = value;
        _appState.NomeArquivoExportacao = value;

        StateHasChanged();
    }

    private async Task Close()
    {
        // reset local confirmed state
        buttonExportDisabled = false;
        textDisabled = false;

        StateHasChanged();

        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private async Task Confirm()
    {
        if (Result == null)
            return;

        if (string.IsNullOrWhiteSpace(abaSelecionadaA)
            || string.IsNullOrWhiteSpace(abaSelecionadaB))
        {
            return;
        }
        // 🔹 chave única da aba B
        string keyB = Helpers.Normalize(abaSelecionadaB);

        // 🔹 salva tudo diretamente no dictionary
        _appState.MapeamentosPorAba[keyB] = new SheetMapping
        {
            NomeAbaA = abaSelecionadaA,
            NomeAbaB = abaSelecionadaB,

            HeadersA = headersAAtual?.ToList() ?? new(),
            HeadersB = headersBAtual?.ToList() ?? new(),

            Mapping = Result.Mapeamento != null
         ? new Dictionary<string, string>(Result.Mapeamento)
         : new(),

            Registros = AplicarValoresCustomizados(),
            ColunasFixasDaBaseA =
         new Dictionary<string, string>(colunasFixasDaBaseA),

            ValoresFixos =
         new Dictionary<string, string>(valoresFixos)
        };

        // 🔹 estado global
        _appState.DelimitadorCsv = delimitadorCsv;
        _appState.NomeArquivoExportacao = nomeArquivoExportacao;

        buttonExportDisabled = false;
        textDisabled = true;
        StateHasChanged();

        var novoResultado = _autoMappingService.AlinharBaseB(
                _appState.BaseA,
                _appState.BaseB,
                colunasFixasDaBaseA,
                valoresFixos
            );

        Result = novoResultado;

        if (OnConfirmed.HasDelegate)
            await OnConfirmed.InvokeAsync();

    }


    private List<GenericRegistration> AplicarValoresCustomizados()
    {
        var registros = Result.Alinhada
            .Select(r => new GenericRegistration
            {
                Campos = new Dictionary<string, string>(r.Campos)
            })
            .ToList();

        foreach (var row in registros.ToList())
        {
            foreach (var coluna in colunasNovas)
            {
                // template personalizado
                if (templatesPersonalizados.TryGetValue(coluna, out var template)
                    && !string.IsNullOrWhiteSpace(template))
                {
                    var valorProcessado = template;

                    // substituir valores da linha
                    foreach (var campo in row.Campos)
                    {
                        valorProcessado = valorProcessado.Replace(
                            $"{{{campo.Key}}}",
                            campo.Value ?? "");
                    }

                    row.Campos[coluna] = valorProcessado;
                }

                // valor fixo
                if (valoresFixos.TryGetValue(coluna, out var valorFixo)
                    && !string.IsNullOrWhiteSpace(valorFixo))
                {
                    row.Campos[coluna] = valorFixo;
                }

                // copiar valor de outra coluna
                else if (colunasFixasDaBaseA.TryGetValue(coluna, out var colunaOrigem)
                && !string.IsNullOrWhiteSpace(colunaOrigem))
                {
                    row.Campos[coluna] =
                        row.Campos.ContainsKey(colunaOrigem)
                            ? row.Campos[colunaOrigem] ?? ""
                            : "";
                }
                // copiar valor de coluna da Base B
                else if (colunasDaBaseB.TryGetValue(coluna, out var colunaB)
                && !string.IsNullOrWhiteSpace(colunaB))
                {
                    row.Campos[coluna] =
                        row.Campos.ContainsKey(colunaB)
                            ? row.Campos[colunaB] ?? ""
                            : "";
                }

                // fallback
                else if (!row.Campos.ContainsKey(coluna))
                {
                    row.Campos[coluna] = "";
                }
            }
        }

        return registros;
    }

}
