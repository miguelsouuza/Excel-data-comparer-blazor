@using System.Linq
@using Microsoft.AspNetCore.Components
@inject IAutoMappingService _autoMappingService

<div>
    <MudButton Color="Color.Secondary" OnClick="ExecuteAlign" Disabled="isProcessing">
        @if (isProcessing)
        {
            <MudProgressCircular Size="Size.Medium" Indeterminate="true" Class="me-2" />
            <span>Processando...</span>
        }
        else
        {
            <span>Alinhar</span>
        }
    </MudButton>
</div>

@code {
    [Parameter]
    public List<GenericRegistration> BaseA { get; set; } = new();

    [Parameter]
    public List<GenericRegistration> BaseB { get; set; } = new();

    [Parameter]
    public EventCallback<AlignmentResult> OnCompleted { get; set; }

    private bool isProcessing = false;

    private async Task ExecuteAlign()
    {
        if (isProcessing)
            return;
        isProcessing = true;

        try
        {
            var ar = _autoMappingService.AlinharBaseB(BaseA, BaseB);
            var headersA =
            BaseA?.FirstOrDefault()?.Campos.Keys.ToList()
            ?? new List<string>();

            var headersB =
                BaseB?.FirstOrDefault()?.Campos.Keys.ToList()
                ?? new List<string>();

            ar.HeadersA = headersA;
            ar.HeadersB = headersB;

            var mappedValues = ar.Mapeamento.Values
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .ToList();

            ar.Renomeadas = ar.Mapeamento
                .Where(kv =>
                    !string.IsNullOrWhiteSpace(kv.Value)
                    && !string.Equals(
                        kv.Key,
                        kv.Value,
                        StringComparison.OrdinalIgnoreCase))
                .Select(kv => (kv.Key, kv.Value))
                .ToList();

            ar.Mantidas = ar.Mapeamento
                .Where(kv =>
                    !string.IsNullOrWhiteSpace(kv.Value)
                    && string.Equals(
                        kv.Key,
                        kv.Value,
                        StringComparison.OrdinalIgnoreCase))
                .Select(kv => kv.Key)
                .ToList();

            ar.Removidas = headersB
                .Where(h =>
                    !mappedValues.Any(v =>
                        string.Equals(v, h, StringComparison.OrdinalIgnoreCase))
                    &&
                    !headersA.Any(a =>
                        string.Equals(a, h, StringComparison.OrdinalIgnoreCase)))
                .ToList();

            ar.Incluidas = headersA
                .Where(h =>
                    !headersB.Any(b =>
                        string.Equals(b, h, StringComparison.OrdinalIgnoreCase)))
                .Select(h => (
                    ColunaA: h,
                    FonteB: ar.Mapeamento.TryGetValue(h, out var src)
                        ? src
                        : ""
                ))
                .ToList();

            if (OnCompleted.HasDelegate)
                await OnCompleted.InvokeAsync(ar);
        }
        finally
        {
            isProcessing = false;
        }
    }
}
