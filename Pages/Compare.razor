@page "/compare"
@rendermode InteractiveServer

@inject ICompareService _compareService
@inject AppState _appState
@inject NavigationManager nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Spacing="2"
              Class="mb-4">

        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="Voltar">

            Voltar
        </MudButton>

        <MudText Typo="Typo.h5">
            Resultado da Comparação
        </MudText>

    </MudStack>

    @if (isLoading)
    {
        <div class="d-flex justify-center">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <!-- 🔥 CARDS RESUMO -->
        <MudGrid>

            <MudItem xs="12" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.subtitle2">Divergências</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Error">
                        @resultado.Diferencas?.Count
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.subtitle2">Em ambas</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success">
                        @resultado.EmAmbas
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.subtitle2">
                        Apenas @_appState.NomeArquivoA
                    </MudText>
                    <MudText Typo="Typo.h5" Color="Color.Warning">
                        @resultado.ApenasA?.Count
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.subtitle2">
                        Apenas @_appState.NomeArquivoB
                    </MudText>
                    <MudText Typo="Typo.h5" Color="Color.Warning">
                        @resultado.ApenasB?.Count
                    </MudText>
                </MudPaper>
            </MudItem>

        </MudGrid>

        <!-- 🔴 ERROS -->
        @if (resultado.Erros?.Any() == true)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                <MudText Typo="Typo.subtitle1">Erros encontrados</MudText>

                <ul>
                    @foreach (var erro in resultado.Erros)
                    {
                        <li>@erro</li>
                    }
                </ul>
            </MudAlert>
        }

        <!-- 🟡 APENAS A / B -->
        <MudGrid Class="mt-4">

            @if (resultado.ApenasA?.Any() == true)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-3">
                        <MudText Typo="Typo.h6" Color="Color.Warning">
                            Apenas em @_appState.NomeArquivoA
                        </MudText>

                        @foreach (var item in resultado.ApenasA.Take(20))
                        {
                            <MudChip T="string" Color="Color.Warning" Class="ma-1">
                                @item
                            </MudChip>
                        }
                    </MudPaper>
                </MudItem>
            }

            @if (resultado.ApenasB?.Any() == true)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-3">
                        <MudText Typo="Typo.h6" Color="Color.Warning">
                            Apenas em @_appState.NomeArquivoB
                        </MudText>

                        @foreach (var item in resultado.ApenasB.Take(20))
                        {
                            <MudChip T="string" Color="Color.Warning" Class="ma-1">
                                @item
                            </MudChip>
                        }
                    </MudPaper>
                </MudItem>
            }

        </MudGrid>

 
        <!-- 🔥 TABELA DIFERENÇAS -->
        @if (resultado.Diferencas?.Any() == true)
        {
            <MudPaper Class="pa-4 mt-4">

                <MudText Typo="Typo.h6" Class="mb-2">
                    Divergências encontradas
                </MudText>

                <TableDifference Difference="resultado.Diferencas"
                                 Title="Diferenças" />

            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Class="mt-4">
                Nenhuma divergência encontrada 🎉
            </MudAlert>
        }
    }

</MudContainer>

@code {
    private CompareResult resultado;
    private bool isLoading = true;    
        
    protected override async Task OnInitializedAsync()
    {
        // roda de forma assíncrona para não bloquear o circuito e mostrar loading
        isLoading = true;

        if (_appState.BaseA == null ||
            _appState.BaseB == null ||
            _appState.IdsA == null || !_appState.IdsA.Any() ||
            _appState.IdsB == null || !_appState.IdsB.Any() ||
            _appState.Mapeamento == null)
        {
            resultado = new CompareResult
            {
                Erros = new List<string> { "Dados insuficientes para comparação" }
            };
            isLoading = false;
            return;
        }

        // Se o serviço tiver uma versão assíncrona, prefira chamá‑la. Caso não, executar em Task.Run para não bloquear.
        resultado = await Task.Run(() => _compareService.Compare(
            _appState.BaseA,
            _appState.BaseB,
            _appState.IdsA,
            _appState.IdsB,
            _appState.Mapeamento
        ));

        isLoading = false;
        StateHasChanged();
    }

    private void Voltar()
    {
        nav.NavigateTo("/");
    }

}