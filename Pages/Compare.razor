@inject ICompareService _compareService
@inject AppState _appState
@rendermode InteractiveServer

@page "/compare"

<h3>Resultado da Comparação</h3>

@if (resultado == null)
{
    <p>Carregando...</p>
}
else
{
    <p><b>Divergências:</b> @resultado.Diferencas?.Count</p>
    <p><b>Registros em ambas:</b> @resultado.EmAmbas</p>
    <p><b>Apenas na @($"{_appState.NomeArquivoA}") :</b> @resultado.ApenasA?.Count</p>
    <p><b>Apenas na @($"{_appState.NomeArquivoB}"):</b> @resultado.ApenasB?.Count</p>

    @if (resultado.Erros != null && resultado.Erros.Any())
    {
        <h4>Erros</h4>
        <ul>
            @foreach (var erro in resultado.Erros)
            {
                <li>@erro</li>
            }
        </ul>
    }

    @if (resultado.ApenasA != null && resultado.ApenasA.Any())
    {
        <h4>Apenas na @($"{_appState.NomeArquivoA}")</h4>
        <ul>
            @foreach (var erro in resultado.ApenasA)
            {
                <li>@erro</li>
            }
        </ul>
    }
    @if (resultado.ApenasB != null && resultado.ApenasB.Any())
    {
        <h4>Apenas na @($"{_appState.NomeArquivoB}")</h4>
        <ul>
            @foreach (var erro in resultado.ApenasB)
            {
                <li>@erro</li>
            }
        </ul>
    }


    else
    {
        <p>Nenhuma divergência encontrada</p>
    }

    @if (resultado.Diferencas != null && resultado.Diferencas.Any())
    {        
       <TableDifference Difference="resultado.Diferencas" Title="Divergências encontradas" />
    }
    else
    {
        <p>Nenhuma divergência encontrada</p>
    }
}

@code {
    private CompareResult resultado;

    protected override void OnInitialized()
    {
        if (_appState.BaseA == null ||
            _appState.BaseB == null ||
            string.IsNullOrWhiteSpace(_appState.ColunaA) ||
            _appState.Mapeamento == null)
        {
            resultado = new CompareResult
            {
                Erros = new List<string> { "Dados insuficientes para comparação" }
            };
            return;
        }

        resultado = _compareService.Compare(
            _appState.BaseA,
            _appState.BaseB,
            _appState.ColunaA,
            _appState.ColunaB,
            _appState.Mapeamento
        );
    }
}