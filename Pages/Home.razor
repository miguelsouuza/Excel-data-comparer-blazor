@page "/"
@rendermode InteractiveServer

@inject FileService _fileService
@inject AppState _appState
@inject NavigationManager nav
@inject IAutoMappingService _autoMappingService

<div class="d-flex gap-4">

    <div>
        <InputFile OnChange="UploadA" />
        <p>Base A: @(baseA.Any() ? "Carregado ✅" : "Não carregado")</p>
    </div>

    <div>
        <InputFile OnChange="UploadB" />
        <p>Base B: @(baseB.Any() ? "Carregado ✅" : "Não carregado")</p>
    </div>

</div>

<h4 class="mt-4">Selecionar Aba</h4>

<div class="d-flex gap-4">

    <div>
        <label>Base A:</label>
        <select value="@AbaSelecionadaA" @onchange="async (ChangeEventArgs e) => { AbaSelecionadaA = e.Value?.ToString(); await CarregarAbasSelecionadas(); }">
            <option value="">Selecione</option>
            @foreach (var aba in AbasA)
            {
                <option value="@aba">@aba</option>
            }
        </select>
    </div>

    <div>
        <label>Base B:</label>
        <!-- Recommended fix (Option B): remove the `@bind` and use explicit onchange handler -->
        <select value="@AbaSelecionadaB" @onchange="OnAbaSelecionadaBChanged">
            <option value="">Selecione</option>
            @foreach (var aba in AbasB)
            {
                <option value="@aba">@aba</option>
            }
        </select>
    </div>

</div>

@if (baseA.Any() && baseB.Any())
{
    var colunasA = baseA.First().Campos.Keys.ToList();
    var colunasB = baseB.First().Campos.Keys.ToList();

    <div class="d-flex gap-4 mt-4">

        <div>
            <h4>ID Base A</h4>
            <select @bind="colunaA">
                <option value="">Selecione...</option>
                @foreach (var col in colunasA)
                {
                    <option value="@col">@col</option>
                }
            </select>
        </div>

        <div>
            <h4>ID Base B</h4>
            <select @bind="colunaB">
                <option value="">Selecione...</option>
                @foreach (var col in colunasB)
                {
                    <option value="@col">@col</option>
                }
            </select>
        </div>

    </div>

    <button @onclick="AutoMapear" class="btn btn-primary mt-3">
        Auto Mapear 🤖
    </button>

    <div class="mt-3">
        <h4>Mapeamento de Colunas</h4>

        @foreach (var colA in colunasA)
        {
            <div class="d-flex gap-2 mb-1 align-items-center">

                <span style="width:200px">@colA</span>

                <select @onchange="(e) => Mapear(colA, e.Value?.ToString())">

                    <option value="">Selecione</option>

                    @foreach (var colB in colunasB)
                    {
                        <option value="@colB"
                                selected="@(mapeamento.ContainsKey(colA) && mapeamento[colA] == colB)">
                            @colB
                        </option>
                    }

                </select>

            </div>
        }
    </div>

    <button @onclick="IrParaComparacao" class="mt-3 btn btn-success">
        Comparar
    </button>
}

@if (baseA.Any())
{
    <TableComponent Base="baseA" Title="Preview Base A" />
}

@if (baseB.Any())
{
    <TableComponent Base="baseB" Title="Preview Base B" />
}

@code {
    private string colunaA = string.Empty;
    private string colunaB = string.Empty;

    private Dictionary<string, string> mapeamento = new();

    private List<GenericRegistration> baseA = new();
    private List<GenericRegistration> baseB = new();

    List<string> AbasA = new();
    List<string> AbasB = new();

    string AbaSelecionadaA;
    string AbaSelecionadaB;

    // 🔹 Upload Base A
    private async Task UploadA(InputFileChangeEventArgs e)
    {
        var file = e.File;

        _appState.StreamA = new MemoryStream();
        await file.OpenReadStream(50 * 1024 * 1024).CopyToAsync(_appState.StreamA);
        _appState.StreamA.Position = 0;

        AbasA = await _fileService.GetSheetNamesAsync(_appState.StreamA);
        _appState.StreamA.Position = 0;
    }

    // 🔹 Upload Base B
    private async Task UploadB(InputFileChangeEventArgs e)
    {
        var file = e.File;

        _appState.StreamB = new MemoryStream();
        await file.OpenReadStream(50 * 1024 * 1024).CopyToAsync(_appState.StreamB);
        _appState.StreamB.Position = 0;

        AbasB = await _fileService.GetSheetNamesAsync(_appState.StreamB);
        _appState.StreamB.Position = 0;
    }

    // 🔥 Carregar abas selecionadas
    private async Task CarregarAbasSelecionadas()
    {
        if (string.IsNullOrEmpty(AbaSelecionadaA) || string.IsNullOrEmpty(AbaSelecionadaB))
            return;

        _appState.StreamA.Position = 0;
        _appState.StreamB.Position = 0;

        var registrosA = await _fileService.ReadExcelAsync(_appState.StreamA, AbaSelecionadaA);
        _appState.StreamA.Position = 0;

        var registrosB = await _fileService.ReadExcelAsync(_appState.StreamB, AbaSelecionadaB);
        _appState.StreamB.Position = 0;

        baseA = registrosA?.Select(d => new GenericRegistration { Campos = d }).ToList() ?? new List<GenericRegistration>();
        baseB = registrosB?.Select(d => new GenericRegistration { Campos = d }).ToList() ?? new List<GenericRegistration>();

        _appState.BaseA = baseA;
        _appState.BaseB = baseB;
    }

    // 🔥 AUTO MAP
    private void AutoMapear()
    {
        if (!baseA.Any() || !baseB.Any())
            return;

        var colunasA = baseA.First().Campos.Keys.ToList();
        var colunasB = baseB.First().Campos.Keys.ToList();

        mapeamento = _autoMappingService.GerarMapeamento(colunasA, colunasB);
    }

    // 🔹 Mapeamento manual
    private void Mapear(string colunaA, string? colunaB)
    {
        if (string.IsNullOrWhiteSpace(colunaB))
        {
            if (mapeamento.ContainsKey(colunaA))
                mapeamento.Remove(colunaA);

            return;
        }

        mapeamento[colunaA] = colunaB;
    }

    // 🔹 Navegar para comparação
    private void IrParaComparacao()
    {
        if (!baseA.Any() || !baseB.Any())
        {
            Console.WriteLine("Bases não carregadas");
            return;
        }

        if (string.IsNullOrWhiteSpace(colunaA) || string.IsNullOrWhiteSpace(colunaB))
        {
            Console.WriteLine("Selecione as colunas de ID");
            return;
        }

        if (!mapeamento.Any())
        {
            Console.WriteLine("Mapeamento não definido");
            return;
        }

        _appState.ColunaA = colunaA;
        _appState.ColunaB = colunaB;
        _appState.Mapeamento = mapeamento;

        nav.NavigateTo("/compare");
    }

    private async Task OnAbaSelecionadaBChanged(ChangeEventArgs e)
    {
        AbaSelecionadaB = e?.Value?.ToString();
        await CarregarAbasSelecionadas();
    }
}