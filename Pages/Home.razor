@page "/"
@layout MainLayout

@inject FileService _fileService
@inject AppState _appState
@inject NavigationManager nav
@inject IAutoMappingService _autoMappingService
@inject IHeaderCompareService _headerCompareService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <MudText Typo="Typo.h4" Class="mb-4">
        Comparador de Dados 📊
    </MudText>

    <!-- 🔹 Upload -->
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Base A</MudText>
                <InputFile OnChange="UploadA" />

                <MudSelect T="string" Label="Aba Base A" @bind-Value="abaSelecionadaA" Class="mt-2">
                    @foreach (var aba in abasA)
                    {
                        <MudSelectItem Value="@aba">@aba</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Base B</MudText>
                <InputFile OnChange="UploadB" />

                <MudSelect T="string" Label="Aba Base B" @bind-Value="abaSelecionadaB" Class="mt-2">
                    @foreach (var aba in abasB)
                    {
                        <MudSelectItem Value="@aba">@aba</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Class="mt-3"
               Variant="Variant.Filled"
               Color="Color.Info"
               OnClick="CarregarAbas">
        Carregar Abas 📂
    </MudButton>

    @if (baseA.Any() && baseB.Any())
    {
        var colunasA = baseA.First().Campos.Keys.ToList();
        var colunasB = baseB.First().Campos.Keys.ToList();

        <!-- 🔹 IDs -->
        <MudGrid Class="mt-4">
            <MudItem xs="6">
                <MudSelect T="string" Label="ID Base A" @bind-Value="colunaA">
                    @foreach (var idColA in colunasA)
                    {
                        <MudSelectItem @key="idColA" Value="@idColA">@idColA</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="6">
                <MudSelect T="string" Label="ID Base B" @bind-Value="colunaB">
                    @foreach (var IdcolB in colunasB)
                    {
                        <MudSelectItem @key="IdcolB" Value="@IdcolB">@IdcolB</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <!-- 🔹 Botões -->
        <MudStack Row="true" Spacing="2" Class="mt-4">

            <MudButton Color="Color.Warning" OnClick="CompararHeaders">
                Comparar Headers 📊
            </MudButton>

            <MudButton Color="Color.Primary" OnClick="AutoMapear">
                Auto Mapear 🤖
            </MudButton>

            <MudButton Color="Color.Success" OnClick="IrParaComparacao">
                Comparar
            </MudButton>

        </MudStack>

        <!-- 🔹 Resultado Headers -->
        @if (headerResult != null)
        {
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h6">Resultado dos Headers</MudText>

                <MudGrid>
                    <MudItem xs="4">
                        <MudText Color="Color.Success">Em comum</MudText>
                        @foreach (var item in headerResult.EmComum)
                        {
                            <MudChip T="string" Color="Color.Success">@item</MudChip>
                        }
                    </MudItem>

                    <MudItem xs="4">
                        <MudText Color="Color.Warning">Apenas A</MudText>
                        @foreach (var item in headerResult.ApenasA)
                        {
                            <MudChip T="string" Color="Color.Warning">@item</MudChip>
                        }
                    </MudItem>

                    <MudItem xs="4">
                        <MudText Color="Color.Error">Apenas B</MudText>
                        @foreach (var item in headerResult.ApenasB)
                        {
                            <MudChip T="string" Color="Color.Error">@item</MudChip>
                        }
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <!-- 🔹 Mapeamento -->
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6">Mapeamento de Colunas</MudText>

            @foreach (var mapColA in colunasA)
            {
                <MudGrid Class="mb-2">
                    <MudItem xs="5">
                        <MudText>@mapColA</MudText>
                    </MudItem>

                    <MudItem xs="7">
                        <MudSelect T="string"
                                   @key="mapColA"
                                   @bind-Value="mapeamentoUI[mapColA]">

                            <MudSelectItem T="string">Selecione</MudSelectItem>

                            @foreach (var enabledColB in GetColunasDisponiveis(mapColA))
                            {
                                <MudSelectItem @key="enabledColB" Value="@enabledColB">@enabledColB</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
    <TableComponent Base="baseA" Title="Preview Base A" />
    <TableComponent Base="baseB" Title="Preview Base B" />
    }
</MudContainer>

@code {
    private string colunaA = "";
    private string colunaB = "";

    private Dictionary<string, string> mapeamento = new();
    private Dictionary<string, string> mapeamentoUI = new();

    private List<string> abasA = new();
    private List<string> abasB = new();

    private string abaSelecionadaA = "";
    private string abaSelecionadaB = "";

    private Stream? streamA;
    private Stream? streamB;

    private HeaderCompareResult? headerResult;

    private List<GenericRegistration> baseA = new();
    private List<GenericRegistration> baseB = new();

    // 🔹 Upload
    private async Task UploadA(InputFileChangeEventArgs e)
    {
        var memory = new MemoryStream();
        await e.File.OpenReadStream(50 * 1024 * 1024).CopyToAsync(memory);
        memory.Position = 0;

        streamA = memory;

        abasA = _fileService.ObterAbas(memory);
        abaSelecionadaA = abasA.FirstOrDefault() ?? "";
    }

    private async Task UploadB(InputFileChangeEventArgs e)
    {
        var memory = new MemoryStream();
        await e.File.OpenReadStream(50 * 1024 * 1024).CopyToAsync(memory);
        memory.Position = 0;

        streamB = memory;

        abasB = _fileService.ObterAbas(memory);
        abaSelecionadaB = abasB.FirstOrDefault() ?? "";
    }

    // 🔥 Carregar abas
    private async Task CarregarAbas()
    {
        if (streamA == null || streamB == null)
            return;

        streamA.Position = 0;
        streamB.Position = 0;

        var dadosA = await _fileService.CarregarExcelPorAba(streamA, abaSelecionadaA);
        var dadosB = await _fileService.CarregarExcelPorAba(streamB, abaSelecionadaB);

        baseA = dadosA.Select(d => new GenericRegistration { Campos = d }).ToList();
        baseB = dadosB.Select(d => new GenericRegistration { Campos = d }).ToList();

        _appState.BaseA = baseA;
        _appState.BaseB = baseB;
        _appState.NomeArquivoA = streamA is FileStream fsA ? Path.GetFileName(fsA.Name) : "Base A";
        _appState.NomeArquivoB = streamB is FileStream fsB ? Path.GetFileName(fsB.Name) : "Base B";
        InicializarMapeamento();
    }

    private void InicializarMapeamento()
    {
        var colunas = baseA.First().Campos.Keys;

        mapeamento = colunas.ToDictionary(k => k, v => "");
        mapeamentoUI = colunas.ToDictionary(k => k, v => "");
    }

    private void AutoMapear()
    {
        var auto = _autoMappingService.GerarMapeamento(
            baseA.First().Campos.Keys.ToList(),
            baseB.First().Campos.Keys.ToList()
        );

        foreach (var item in auto)
        {
            mapeamento[item.Key] = item.Value;
            mapeamentoUI[item.Key] = item.Value;
        }
    }

    private void CompararHeaders()
    {
        headerResult = _headerCompareService.Comparar(
            baseA.First().Campos.Keys.ToList(),
            baseB.First().Campos.Keys.ToList());
    }

    private List<string> GetColunasDisponiveis(string colunaAtual)
    {
        var todas = baseB.First().Campos.Keys.ToList();

        var usadas = mapeamento
            .Where(x => x.Key != colunaAtual)
            .Select(x => x.Value)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .ToHashSet();

        return todas
            .Where(col => !usadas.Contains(col) || mapeamento[colunaAtual] == col)
            .ToList();
    }

    private void IrParaComparacao()
    {
        _appState.ColunaA = colunaA;
        _appState.ColunaB = colunaB;
        _appState.Mapeamento = mapeamento;

        nav.NavigateTo("/compare");
    }
}