@page "/"
@using DataComparer.Models
@layout MainLayout

@inject IHeaderCompareService _headerCompareService
@inject IAutoMappingService _autoMappingService
@inject IFileService _fileService
@inject AppState _appState
@inject NavigationManager nav


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <MudText Typo="Typo.h4" Class="mb-4">
        Comparador de Dados 📊
    </MudText>

    <!-- 🔹 Upload -->
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Base A</MudText>
                <MudFileUpload T="IBrowserFile"
                               FilesChanged="UploadA"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.UploadFile">
                </MudFileUpload>

                <MudSelect T="string" Label="Aba Base A" @bind-Value="abaSelecionadaA" Class="mt-2">
                    @foreach (var aba in abasA)
                    {
                        <MudSelectItem Value="@aba">@aba</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Base B</MudText>
                <MudFileUpload T="IBrowserFile"
                               FilesChanged="UploadB"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.UploadFile">
                </MudFileUpload>

                <MudSelect T="string" Label="Aba Base B" @bind-Value="abaSelecionadaB" Class="mt-2">
                    @foreach (var aba in abasB)
                    {
                        <MudSelectItem Value="@aba">@aba</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Class="mt-3"
               Variant="Variant.Filled"
               Color="Color.Info"
               OnClick="CarregarAbas">
        Carregar Abas 📂
    </MudButton>

    @if (baseA.Any() && baseB.Any())
    {
        var colunasA = baseA.First().Campos.Keys.ToList();
        var colunasB = baseB.First().Campos.Keys.ToList();
       
        <!-- 🔹 Botões -->
        <MudStack Row="true" Spacing="2" Class="mt-4">

            <MudButton Color="Color.Warning" OnClick="CompararHeaders">
                Exibir Comparador 📊
            </MudButton>

            <AlignAction BaseA="baseA" BaseB="baseB" OnCompleted="HandleAligned" />

        </MudStack>
        
        @if (alignmentResult != null)
        {
            <MudPaper Class="pa-4 mt-4">
                <AlignPreview Result="alignmentResult"
                              abaSelecionadaA="@abaSelecionadaA"
                              abaSelecionadaB="@abaSelecionadaB"
                              headersAAtual="@baseA.First().Campos.Keys.ToList()"
                              headersBAtual="@baseB.First().Campos.Keys.ToList()"
                              mappingAtual="@mapeamento"
                              OnConfirmed="HandleConfirmed"
                              OnClose="HandleClosePreview" />
            </MudPaper>
        }

        <!-- 🔹 Comparadores-->
        @if (headerResult != null)
        {
            <!-- 🔹 Mapeamento Headers-->
            @if (_appState.ShowMappingHeader)
            {
                <MudPaper Class="pa-4 mt-4">
                    <MappingHeader HeaderResult="headerResult" showMappingHeader="_appState.ShowMappingHeader" />
                </MudPaper>
            }
        }
        
        <!-- 🔹 Mapeamento Colunas-->
        @if (_appState.ShowMappingColumn)
        {
            <MudPaper Class="pa-4 mt-4">
                <MappingColumn BaseA="baseA"
                               BaseB="baseB"
                               Mapeamento="mapeamento"
                               MapeamentoUI="mapeamentoUI"
                               showMappingColumn="_appState.ShowMappingColumn"
                               IdsA="IdsA" IdsB="IdsB"
                               ColunasA="colunasA" ColunasB="colunasB" />
            </MudPaper>
        }

        
        <TableComponent Base="baseA" Title="Preview Base A" />
        <TableComponent Base="baseB" Title="Preview Base B" />
    }
</MudContainer>

    @code {
    public List<string> IdsA { get; set; } = new();
    public List<string> IdsB { get; set; } = new();

    private Dictionary<string, string> mapeamento = new();
    private Dictionary<string, string> mapeamentoUI = new();
    private Dictionary<string,SheetMapping> mapeamentosPorAba = new();

    private List<string> abasA = new();
    private List<string> abasB = new();

    private string abaSelecionadaA = "";
    private string abaSelecionadaB = "";
    private Stream? streamA;
    private Stream? streamB;

    private HeaderCompareResult? headerResult;

    private List<GenericRegistration> baseA = new();
    private List<GenericRegistration> baseB = new();
    private AlignmentResult? alignmentResult;
    private string? originalNomeArquivoB;

    private bool carregandoArquivo = false;

    protected override void OnInitialized()
    {
        // 🔹 Restaurar bases
        baseA = _appState.BaseA ?? new();
        baseB = _appState.BaseB ?? new();

        // 🔹 Restaurar mapeamentos
        mapeamento = _appState.Mapeamento ?? new();
        mapeamentosPorAba  = _appState.MapeamentosPorAba ?? new();
        mapeamentoUI = _appState.MapeamentoUI ?? new();

        // 🔹 Restaurar IDs
        IdsA = _appState.IdsA ?? new();
        IdsB = _appState.IdsB ?? new();

        // 🔹 Restaurar nomes
        originalNomeArquivoB = _appState.NomeArquivoB;

        // 🔹 Restaurar colunas
        if (baseA.Any())
        {
            var colunas = baseA.First().Campos.Keys;

            if (!mapeamento.Any())
                mapeamento = colunas.ToDictionary(k => k, v => "");

            if (!mapeamentoUI.Any())
                mapeamentoUI = colunas.ToDictionary(k => k, v => "");
        }
    }
        
    // 🔹 Upload
    private async Task UploadA(IBrowserFile file)
    {
        if (carregandoArquivo)
            return;

        carregandoArquivo = true;

        try
        {
            var memory = new MemoryStream();
            await file
                .OpenReadStream(50 * 1024 * 1024)
                .CopyToAsync(memory);
            memory.Position = 0;
            _appState.StreamA = memory;
            var extensao = Path.GetExtension(file.Name).ToLower();

            if (extensao == ".xlsx")
            {
                abasA = _fileService.ObterAbas(memory);
                abaSelecionadaA = abasA.FirstOrDefault() ?? "";
            }
            else
            {
                abasA = new() { "Arquivo Único" };
                abaSelecionadaA = "Arquivo Único";
            }
            _appState.NomeArquivoA = file.Name;
        }
        finally
        {
            carregandoArquivo = false;
        }
    }

    private async Task UploadB(IBrowserFile file)
    {
        if (carregandoArquivo)
            return;

        carregandoArquivo = true;

        try
        {
            var memory = new MemoryStream();
            await file
                .OpenReadStream(50 * 1024 * 1024)
                .CopyToAsync(memory);

            memory.Position = 0;
            _appState.StreamB = new MemoryStream(memory.ToArray());
            var extensao = Path.GetExtension(file.Name).ToLower();
            if (extensao == ".xlsx")
            {
                abasB = _fileService.ObterAbas(memory);
                abaSelecionadaB = abasB.FirstOrDefault() ?? "";
            }
            else
            {
                abasB = new() { "Arquivo Único" };
                abaSelecionadaB = "Arquivo Único";
            }
            _appState.NomeArquivoB = file.Name;
        }
        finally
        {
            carregandoArquivo = false;
        }
    }

    // 🔥 Carregar abas
    private async Task CarregarAbas()
    {
        if (_appState.StreamA == null || _appState.StreamB == null)
            return;

        _appState.StreamA.Position = 0;
        _appState.StreamB.Position = 0;

        var extA = Path.GetExtension(_appState.NomeArquivoA).ToLower();
        var extB = Path.GetExtension(_appState.NomeArquivoB).ToLower();

        List<Dictionary<string, string>> dadosA;
        List<Dictionary<string, string>> dadosB;

        // 🔹 BASE A
        if (extA == ".xlsx")
        {
            dadosA = await _fileService.CarregarExcelPorAba(
                _appState.StreamA,
                abaSelecionadaA);
        }
        else
        {
            dadosA = (await _fileService.CarregarTxt(_appState.StreamA))
                .Select(x => x.Campos)
                .ToList();
        }

        // 🔹 BASE B
        if (extB == ".xlsx")
        {
            dadosB = await _fileService.CarregarExcelPorAba(
                _appState.StreamB,
                abaSelecionadaB);
        }
        else
        {
            dadosB = (await _fileService.CarregarTxt(_appState.StreamB))
                .Select(x => x.Campos)
                .ToList();
        }

        baseA = dadosA
            .Select(d => new GenericRegistration
            {
                Campos = d
            })
            .ToList();

        baseB = dadosB
            .Select(d => new GenericRegistration
            {
                Campos = d
            })
            .ToList();

        _appState.BaseA = baseA;
        _appState.BaseB = baseB;

        if (string.IsNullOrWhiteSpace(_appState.NomeArquivoA))
            _appState.NomeArquivoA = "Base A";

        if (string.IsNullOrWhiteSpace(_appState.NomeArquivoB))
            _appState.NomeArquivoB = "Base B";

        originalNomeArquivoB ??= _appState.NomeArquivoB;

        InicializarMapeamento();
    }

    private void InicializarMapeamento()
    {
        var colunas = baseA.First().Campos.Keys;

        mapeamento = colunas.ToDictionary(k => k, v => "");
        mapeamentoUI = colunas.ToDictionary(k => k, v => "");
    }

    private void AlinharBaseB()
    {
        var result = _autoMappingService.AlinharBaseB(baseA, baseB);

        // atualizar baseB local e estado da aplicação
        baseB = result.Alinhada;
        _appState.BaseB = baseB;

        // atualizar mapeamento utilizado
        mapeamento = result.Mapeamento;
        mapeamentoUI = mapeamento.ToDictionary(k => k.Key, v => v.Value);
    }

    private void CompararHeaders()
    {
        headerResult = _headerCompareService.Comparar(
            baseA.First().Campos.Keys.ToList(),
            baseB.First().Campos.Keys.ToList());

        _appState.ShowMappingColumn = true;
        _appState.ShowMappingHeader = true;
        alignmentResult = null;
        StateHasChanged();
    }

  

    private void BaixarCsv()
    {
        nav.NavigateTo("/download/baseb/csv", true);
    }

    private void BaixarXlsx()
    {
        nav.NavigateTo("/download/baseb/xlsx", true);
    }

    private void HandleAligned(AlignmentResult result)
    {
        alignmentResult = result;
        _appState.ShowMappingColumn = false;
        _appState.ShowMappingHeader = false;
    }

    private void HandleConfirmed()
    {
        if (alignmentResult != null)
        {
            baseB = alignmentResult.Alinhada;
            _appState.BaseB = baseB;

            mapeamento = alignmentResult.Mapeamento;
            mapeamentoUI = mapeamento.ToDictionary(k => k.Key, v => v.Value);
            // garantir que o nome do arquivo para download mantenha o nome original do arquivo B
            if (!string.IsNullOrWhiteSpace(originalNomeArquivoB))
                _appState.NomeArquivoB = originalNomeArquivoB;
        }
    }

    private void HandleClosePreview()
    {
        // simplesmente descarta o resultado de alinhamento (fecha o preview)
        alignmentResult = null;
        StateHasChanged();
    }
}