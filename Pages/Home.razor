@page "/"
@layout MainLayout

@inject FileService _fileService
@inject AppState _appState
@inject NavigationManager nav
@inject IAutoMappingService _autoMappingService
@inject IHeaderCompareService _headerCompareService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <MudText Typo="Typo.h4" Class="mb-4">
        Comparador de Dados 📊
    </MudText>

    <!-- 🔹 Upload -->
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Base A</MudText>
                <InputFile OnChange="UploadA" />
                <MudText Class="mt-2">@(_appState.NomeArquivoA ?? "Nenhum arquivo")</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Base B</MudText>
                <InputFile OnChange="UploadB" />
                <MudText Class="mt-2">@(_appState.NomeArquivoB ?? "Nenhum arquivo")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (baseA.Any() && baseB.Any())
    {
        var colunasA = baseA.First().Campos.Keys.ToList();
        var colunasB = baseB.First().Campos.Keys.ToList();

        <!-- 🔹 Seleção ID -->
        <MudGrid Class="mt-4">
            <MudItem xs="6">
                <MudSelect T="string" Label="ID Base A" @bind-Value="colunaA">
                    @foreach (var col in colunasA)
                    {
                        <MudSelectItem Value="@col">@col</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="6">
                <MudSelect T="string" Label="ID Base B" @bind-Value="colunaB">
                    @foreach (var col in colunasB)
                    {
                        <MudSelectItem Value="@col">@col</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <!-- 🔹 Ações -->
        <MudStack Row="true" Spacing="2" Class="mt-4">

            <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="CompararHeaders">
                Comparar Headers 📊
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AutoMapear">
                Auto Mapear 🤖
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="IrParaComparacao">
                Comparar
            </MudButton>

        </MudStack>

        <!-- 🔹 Resultado Header -->
        @if (headerResult != null)
        {
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h6">Resultado dos Headers</MudText>

                <MudGrid>

                    <MudItem xs="4">
                        <MudText Color="Color.Success">Em comum</MudText>
                        @foreach (var item in headerResult.EmComum)
                        {
                            <MudChip T="string" Color="Color.Success" Class="ma-1">@item</MudChip>
                        }
                    </MudItem>

                    <MudItem xs="4">
                        <MudText Color="Color.Warning">Apenas A</MudText>
                        @foreach (var item in headerResult.ApenasA)
                        {
                            <MudChip T="string" Color="Color.Warning" Class="ma-1">@item</MudChip>
                        }
                    </MudItem>

                    <MudItem xs="4">
                        <MudText Color="Color.Error">Apenas B</MudText>
                        @foreach (var item in headerResult.ApenasB)
                        {
                            <MudChip T="string" Color="Color.Error" Class="ma-1">@item</MudChip>
                        }
                    </MudItem>

                </MudGrid>
            </MudPaper>
        }

        <!-- 🔹 Mapeamento -->
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6">Mapeamento de Colunas</MudText>

            @foreach (var colA in colunasA)
            {
                <MudGrid Class="mb-2">

                    <MudItem xs="5">
                        <MudText>@colA</MudText>
                    </MudItem>

                    <MudItem xs="7">
                        <MudSelect T="string"
                                   @bind-Value="mapeamentoUI[colA]">

                            <MudSelectItem T="string" >Selecione</MudSelectItem>

                            @foreach (var colB in GetColunasDisponiveis(colA))
                            {
                                <MudSelectItem Value="@colB">@colB</MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                </MudGrid>
            }
        </MudPaper>
    }

</MudContainer>

@code {
    private string colunaA = "";
    private string colunaB = "";

    private Dictionary<string, string> mapeamento = new();
    private Dictionary<string, string> mapeamentoUI = new();

    private HeaderCompareResult? headerResult;

    private List<GenericRegistration> baseA = new();
    private List<GenericRegistration> baseB = new();

    // 🔹 Upload
    private async Task UploadA(InputFileChangeEventArgs e)
    {
        var file = e.File;

        using var stream = file.OpenReadStream(50 * 1024 * 1024);
        baseA = await _fileService.CarregarArquivoAsync(stream, file.Name);

        _appState.BaseA = baseA;

        InicializarMapeamento();
    }

    private async Task UploadB(InputFileChangeEventArgs e)
    {
        var file = e.File;

        using var stream = file.OpenReadStream(50 * 1024 * 1024);
        baseB = await _fileService.CarregarArquivoAsync(stream, file.Name);

        _appState.BaseB = baseB;
    }

    // 🔥 Inicialização correta
    private void InicializarMapeamento()
    {
        if (!baseA.Any())
            return;

        var colunas = baseA.First().Campos.Keys;

        mapeamento = colunas.ToDictionary(k => k, v => "");
        mapeamentoUI = colunas.ToDictionary(k => k, v => "");
    }

    // 🔥 AutoMap CORRIGIDO
    private void AutoMapear()
    {
        var auto = _autoMappingService.GerarMapeamento(
            baseA.First().Campos.Keys.ToList(),
            baseB.First().Campos.Keys.ToList()
        );

        foreach (var col in baseA.First().Campos.Keys)
        {
            if (!mapeamento.ContainsKey(col))
                mapeamento[col] = "";

            if (!mapeamentoUI.ContainsKey(col))
                mapeamentoUI[col] = "";
        }

        foreach (var item in auto)
        {
            mapeamento[item.Key] = item.Value;
            mapeamentoUI[item.Key] = item.Value; // 🔥 sincroniza UI
        }
    }

    private void CompararHeaders()
    {
        var colunasA = baseA.First().Campos.Keys.ToList();
        var colunasB = baseB.First().Campos.Keys.ToList();

        headerResult = _headerCompareService.Comparar(colunasA, colunasB);
    }

    // 🔥 FILTRO FINAL CORRIGIDO
    private List<string> GetColunasDisponiveis(string colunaAtual)
    {
        var todas = baseB.First().Campos.Keys.ToList();

        var usadas = mapeamento
            .Where(x => x.Key != colunaAtual)
            .Select(x => x.Value)
            .Where(v => !string.IsNullOrWhiteSpace(v)) // 🔥 ESSENCIAL
            .ToHashSet();

        return todas
            .Where(col =>
                !usadas.Contains(col) ||
                (mapeamento[colunaAtual] == col))
            .ToList();
    }

    private void IrParaComparacao()
    {
        if (!baseA.Any() || !baseB.Any())
            return;

        if (string.IsNullOrWhiteSpace(colunaA) || string.IsNullOrWhiteSpace(colunaB))
            return;

        if (!mapeamento.Any())
            return;

        _appState.ColunaA = colunaA;
        _appState.ColunaB = colunaB;
        _appState.Mapeamento = mapeamento;

        nav.NavigateTo("/compare");
    }
}